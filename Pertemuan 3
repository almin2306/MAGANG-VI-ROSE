esp_err_t mulai_esp_now(int index_mac_address) {
    WiFi.mode(WIFI_STA);
    WiFi.disconnect();

    /* Init ESP-NOW */
    esp_err_t result = esp_now_init();
    if (result != ESP_OK)
        return result;

    /* Set callback function to handle received data */
    result = esp_now_register_recv_cb(callback_data_esp_now);
    if (result != ESP_OK)
        return result;

    result = esp_now_register_send_cb(callback_pengiriman_esp_now);
    //     if (result != ESP_OK)
    //         return result;

    /* Set MAC Address */
    uint8_t mac[MAC_ADDRESS_LENGTH];
    memcpy(mac, mac_addresses[index_mac_address], MAC_ADDRESS_LENGTH);
    result = esp_wifi_set_mac(WIFI_IF_STA, mac);
    if (result != ESP_OK)
        return result;

    /* Initialize peer_info and set fields*/
    memset(&peer_info, 0, sizeof(esp_now_peer_info_t));
    peer_info.channel = 0;
    peer_info.encrypt = false;

    /* Add All MAC to peer list  */
    for (int i = 0; i < MAC_ADDRESS_TOTAL; i++) {
        memcpy(peer_info.peer_addr, mac_addresses[i], MAC_ADDRESS_LENGTH);
        result = esp_now_add_peer(&peer_info);
        if (result != ESP_OK)
            return result;
    }

    return ESP_OK;
}

int cari_mac_index(const uint8_t *mac) {
    for (int i = 0; i < MAC_ADDRESS_TOTAL; i++) {
        // Compare the MAC address
        if (memcmp(mac, mac_addresses[i], MAC_ADDRESS_LENGTH) == 0)
            return i;
    }

    // if not found return -1
    return -1;
}

String mac_index_to_names(int mac_index) {
    if ((mac_index < 0 || mac_index >= MAC_ADDRESS_TOTAL) || (mac_index == -1)) {
        return "Unknown";
    }
    return mac_names[mac_index];
}

void callback_data_esp_now(const uint8_t *mac, const uint8_t *data, int len) {
    int index_mac_asal = cari_mac_index(mac);
    process_perintah(data, len, index_mac_asal);
}
void callback_pengiriman_esp_now(const uint8_t *mac_addr, esp_now_send_status_t status) {
    Serial.printf("\nStatus pengiriman ESP-NOW: %s\n", esp_err_to_name(status));
}
void callback_data_serial(const uint8_t *data, int len) {
    process_perintah(data, len);
}
void baca_serial(void (*callback)(const uint8_t *data, int len)) {
    static uint8_t tempBuffer[BUFFER_SIZE];
    static int bytesLen = 0;

    while (Serial.available() > 0) {
        char incomingChar = Serial.read();

        if (incomingChar == '\n' || incomingChar == '\r') {
            if (bytesLen > 0) {
                tempBuffer[bytesLen] = '\0';
                callback(tempBuffer, bytesLen);
                bytesLen = 0;
            }
        } else {
            if (bytesLen < BUFFER_SIZE - 1) {
                tempBuffer[bytesLen++] = (uint8_t)incomingChar;
            }
        }
    }
}

void process_perintah(const uint8_t *data, int len, int index_mac_address_asal) {
    String strPayload = "";
    for (int i = 0; i < len; i++) {
        strPayload += (char)data[i];
    }
    strPayload.trim();

    if (index_mac_address_asal == -1) {
        int posSpace = strPayload.indexOf(' ');
        String command = (posSpace == -1) ? strPayload : strPayload.substring(0, posSpace);
        String destName = (posSpace == -1) ? "" : strPayload.substring(posSpace + 1);
        destName.trim();

        int destIdx = -1;
        for (int i = 0; i < MAC_ADDRESS_TOTAL; i++) {
            if (String(mac_names[i]).equalsIgnoreCase(destName)) {
                destIdx = i;
                break;
            }
        }

        if (destIdx == -1) {
            Serial.println("[ERROR] Nama tujuan tidak ditemukan!");
            return;
        }

        String myIdentity = mac_index_to_names(mac_index_ku);

        if (command.equalsIgnoreCase("HALO")) {
            String outMessage = String(HALO) + ", 'Halo " + destName + " Aku " + myIdentity + "'";
            esp_now_send(mac_addresses[destIdx], (uint8_t *)outMessage.c_str(), outMessage.length());
            Serial.printf("[KIRIM SERIAL -> ESP-NOW]: %s\n", outMessage.c_str());
        } 
        else if (command.equalsIgnoreCase("CEK")) {
            String outMessage = String(CEK) + ", '" + destName + " ini " + myIdentity + " apa kamu disana?'";
            esp_now_send(mac_addresses[destIdx], (uint8_t *)outMessage.c_str(), outMessage.length());
            Serial.printf("[KIRIM SERIAL -> ESP-NOW]: %s\n", outMessage.c_str());
        }
    } 
    else {
        String senderIdentity = mac_index_to_names(index_mac_address_asal);
        String myIdentity = mac_index_to_names(mac_index_ku);

        int posComma = strPayload.indexOf(',');
        if (posComma == -1) return;

        int cmdCode = strPayload.substring(0, posComma).toInt();
        String msgBody = strPayload.substring(posComma + 1);
        msgBody.trim();

        if (cmdCode == HALO) {
            String replyMessage = String(JAWAB) + ", 'Halo Juga " + senderIdentity + " Aku " + myIdentity + "'";
            esp_now_send(mac_addresses[index_mac_address_asal], (uint8_t *)replyMessage.c_str(), replyMessage.length());
            Serial.printf("[ESP-NOW] Terima HALO dari %s. Mengirim balasan...\n", senderIdentity.c_str());

        } else if (cmdCode == CEK) {
            String replyMessage = String(JAWAB) + ", 'Iya Aku " + senderIdentity + " Disini - " + myIdentity + "'";
            esp_now_send(mac_addresses[index_mac_address_asal], (uint8_t *)replyMessage.c_str(), replyMessage.length());
            Serial.printf("[ESP-NOW] Terima CEK dari %s. Mengirim balasan...\n", senderIdentity.c_str());

        } else if (cmdCode == JAWAB) {
            Serial.printf("[JAWAB DARI %s]: %s\n", senderIdentity.c_str(), msgBody.c_str());
        }
    }
}

